<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Identidade do app: fonte Nunito e tons terrosos/verde em todas as telas.
         Claro e escuro são estilos explícitos: a tela escolhe um deles conforme o tema do app
         (automático, claro ou escuro), e não só conforme o do sistema. -->
    <style name="AppThemeLight" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:colorPrimary">#2F7D4F</item>
        <item name="android:colorPrimaryDark">#2F7D4F</item>
        <item name="android:colorAccent">#2F7D4F</item>
        <item name="android:colorControlActivated">#2F7D4F</item>
        <item name="android:textColorHighlight">#552F7D4F</item>
        <item name="android:windowBackground">#FFF6F5F0</item>
    </style>

    <style name="AppThemeDark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:colorPrimary">#2F7D4F</item>
        <item name="android:colorPrimaryDark">#2F7D4F</item>
        <item name="android:colorAccent">#5FBF86</item>
        <item name="android:colorControlActivated">#5FBF86</item>
        <item name="android:textColorHighlight">#555FBF86</item>
        <item name="android:windowBackground">#FF0F1411</item>
    </style>

    <!-- Tema do manifest: define a janela de abertura (values-night troca para o escuro). -->
    <style name="AppTheme" parent="AppThemeLight" />

    <style name="AppDialogLight" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">#2F7D4F</item>
        <item name="android:colorControlActivated">#2F7D4F</item>
        <item name="android:textColorPrimary">#1F2A24</item>
        <item name="android:textColorSecondary">#7B867F</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
        <item name="android:windowTitleStyle">@style/AppDialogTitleLight</item>
    </style>

    <style name="AppDialogDark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:windowBackground">@drawable/dialog_bg_dark</item>
        <item name="android:colorAccent">#5FBF86</item>
        <item name="android:colorControlActivated">#5FBF86</item>
        <item name="android:textColorPrimary">#E6EDE8</item>
        <item name="android:textColorSecondary">#8C988F</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
        <item name="android:windowTitleStyle">@style/AppDialogTitleDark</item>
    </style>

    <!-- Formulários em "folha" que sobe da base da tela (ex.: novo/editar hábito). A folha, com cantos e cores,
         é desenhada em código; o tema só deixa a janela transparente e sem animação própria. -->
    <style name="AppSheetLight" parent="@android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:colorAccent">#2F7D4F</item>
        <item name="android:colorControlActivated">#2F7D4F</item>
        <item name="android:textColorPrimary">#1F2A24</item>
        <item name="android:textColorSecondary">#7B867F</item>
    </style>

    <style name="AppSheetDark" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:colorAccent">#5FBF86</item>
        <item name="android:colorControlActivated">#5FBF86</item>
        <item name="android:textColorPrimary">#E6EDE8</item>
        <item name="android:textColorSecondary">#8C988F</item>
    </style>

    <style name="AppDialogTitleLight">
        <item name="android:textAppearance">@android:style/TextAppearance.Material.DialogWindowTitle</item>
        <item name="android:fontFamily">@font/nunito_black</item>
        <item name="android:textColor">#1F2A24</item>
        <item name="android:textSize">21sp</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="AppDialogTitleDark">
        <item name="android:textAppearance">@android:style/TextAppearance.Material.DialogWindowTitle</item>
        <item name="android:fontFamily">@font/nunito_black</item>
        <item name="android:textColor">#E6EDE8</item>
        <item name="android:textSize">21sp</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="AppDialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
